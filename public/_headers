# Cloudflare Workers Assets headers — hoạt động NGAY CẢ khi run_worker_first:false
# (worker không chạy cho static assets; trước đây security headers chỉ có trong worker → HTML/assets mất hết)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# assets có hash tên file → immutable 1 năm
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ảnh/fonts — cache ngắn/1 năm (worker cache code không chạy khi run_worker_first:false)
/*.png
/*.webp
/*.jpg
/*.jpeg
/*.gif
/*.svg
  Cache-Control: public, max-age=86400

/*.woff2
/*.woff
/*.ttf
/*.eot
  Cache-Control: public, max-age=31536000, immutable
