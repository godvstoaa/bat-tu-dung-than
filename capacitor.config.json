{
  "appId": "shop.god8.lvdang",
  "appName": "Lữ Đăng",
  "webDir": "dist-ios",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a0913",
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#0a0913",
      "showSpinner": false,
      "fadeInDuration": 150,
      "fadeOutDuration": 300
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0913",
      "overlaysWebView": false
    }
  }
}
