[{"name":"stats","x":0,"z":2050,"wait":15000,"eval":"(()=>{const out=[];let t=0;window.__hq.renderer.scene.traverse(o=>{if(o.isMesh&&o.name&&o.name.startsWith('wall-')){const g=o.geometry;const c=(g.index?g.index.count:g.attributes.position.count)/3*(o.isInstancedMesh?o.count:1);t+=c;out.push(o.name+'='+Math.round(c/1000)+'k');}});return out.join(' ')+' TOTAL '+Math.round(t/1000)+'k'})()"}]
